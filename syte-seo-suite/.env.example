VITE_SUPABASE_URL=https://[project].supabase.co
VITE_SUPABASE_ANON_KEY=[anon key]

# --- Server-side (Netlify function) env vars — not exposed to the browser ---
# SEO baseline webhook: fired when a client's first monthly report is approved.
# Optional shared secret; when set it's sent to the hook as `Authorization: Bearer <secret>`.
# SEO_BASELINE_WEBHOOK_SECRET=[shared secret]
# Optional override of the hook endpoint (defaults to the SuperAgent public hook).
# SEO_BASELINE_WEBHOOK_URL=https://sytesuperagent.sytedashboardai.xyz/api/public/hooks/seo-baseline
