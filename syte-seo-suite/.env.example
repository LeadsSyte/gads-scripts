VITE_SUPABASE_URL=https://[project].supabase.co
VITE_SUPABASE_ANON_KEY=[anon key]

# ── Built-in AEO engine keys (set these in Netlify → Site settings → Environment variables) ──
# Server-side secrets used by the openai-proxy / gemini-proxy functions. They
# stay on the server and never reach the browser, so ChatGPT + Gemini work for
# every operator without anyone pasting a personal key.
OPENAI_API_KEY=sk-proj-...
GOOGLE_AI_KEY=AIza...
# Public flag (must start with VITE_ to reach the client) telling the UI which
# engines have a built-in key, so their status dots show green and runs include
# them even when no personal key is entered. Set to match the keys above.
VITE_BUILTIN_ENGINES=chatgpt,gemini
